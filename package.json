{
  "name": "smart-library-system",
  "version": "1.0.0",
  "description": "AI-Powered Smart Library Management System",
  "main": "api/index.js",
  "scripts": {
    "start": "node backend/server.js",
    "backend": "cd backend && npm start",
    "frontend": "cd frontend && npm run dev",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "seed": "cd backend && npm run seed",
    "test": "cd backend && npm test",
    "view-db": "cd backend && npm run view-db",
    "sync-atlas": "cd backend && npm run sync-atlas"
  },
  "dependencies": {
    "alasql": "^4.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.8.0",
    "mongodb-memory-server": "^11.3.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.3"
  }
}